; world4_valley.mus - BIG WORLD, the valley.  G major, tempo 6 (125 BPM).
; A country dance: a plucked tune in eighths, then brass for the second half,
; over a walking bass and a woodblock trot.  16 bars:
; G C G D | G C D G | Em C G D | C D G G.
tempo 6

pattern wG { @bass o2 g4 b4 o3 d4 o2 b4 }
pattern wC { @bass o2 c4 e4 g4 e4 }
pattern wD { @bass o2 d4 f+4 a4 f+4 }
pattern wE { @bass o2 e4 g4 b4 g4 }
pattern trot { @kick o4 c8 @click o7 c8 @hat o7 c8 @click o7 c8 @kick o4 c8 @click o7 c8 @hat o7 c8 @click o7 c8 }
pattern fill { @kick o4 c8 @click o7 c8 @tom o4 c8 @tom o3 a8 @tom o3 f8 @tom o3 d8 @crash o6 a8 r8 }

v1 {
  @pluck
  o5 g8 g8 b8 o6 d8 o5 b8 g8 a8 b8
  o6 c8 o5 b8 a8 g8 e8 g8 a4
  o5 b8 o6 d8 g8 d8 o5 b8 g8 b8 o6 d8
  o5 a4 f+8 a8 d4 r4
  o5 g8 g8 b8 o6 d8 o5 b8 g8 a8 b8
  o6 c8 e8 d8 c8 o5 b8 a8 g8 e8
  o5 f+8 a8 o6 d8 c8 o5 b8 a8 f+8 a8
  o5 g2. r4
  @brass
  o5 e4. f+8 g4 b4
  o5 a4. g8 e4 c4
  o5 d4 g4 b4 o6 d4
  o5 a2 f+4 a4
  o5 g4. f+8 e4 g4
  o5 f+4. g8 a4 o6 c4
  o5 b2 o6 d2
  o6 g2. r4
}
v2 { $wG $wC $wG $wD $wG $wC $wD $wG $wE $wC $wG $wD $wC $wD $wG $wG }
v3 { [$trot]7 $fill [$trot]7 $fill }
